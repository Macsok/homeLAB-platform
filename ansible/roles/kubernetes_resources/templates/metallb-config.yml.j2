---
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: "{{ metallb_pool_name }}"
  namespace: metallb-system
spec:
  addresses:
    - "{{ metallb_address_pool }}"
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: "{{ metallb_pool_name }}"
  namespace: metallb-system
spec:
  ipAddressPools:
    - "{{ metallb_pool_name }}"
